{
  "name": "edunotes",
  "version": "1.0.0",
  "description": "Node.js Backend API for EduNotes.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Softy-Education/ghassen_gestion_notes_backend"
  },
  "author": "Mohamed Ghassen Hammami & SoftyLines",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "serve": "npm run build && node -r ts-node/register/transpile-only -r tsconfig-paths/register -r dotenv/config dist/server.js",
    "check": "ts-node-dev -r tsconfig-paths/register src/helpers/checks.ts",
    "dev": "ts-node-dev -r tsconfig-paths/register --watch 'src/**/*.ts' -r dotenv/config src/server.ts",
    "nodemon": "nodemon -r tsconfig-paths/register --watch src/**/*.ts -r dotenv/config src/server.ts",
    "seed": "ts-node-dev -r tsconfig-paths/register -r dotenv/config src/helpers/seeder/index.ts",
    "init": "npm-run-all seed nodemon",
    "migrate:invitation-status": "ts-node -r tsconfig-paths/register -r dotenv/config src/scripts/migrateInvitationStatus.ts"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "minimist": "^1.2.8",
    "mongodb": "^6.6.1",
    "mongoose": "^8.3.5",
    "mongoose-aggregate-paginate-v2": "^1.0.7",
    "mongoose-paginate-v2": "^1.8.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.13",
    "openai": "^4.47.1",
    "socket.io": "^4.7.5",
    "ts-node-dev": "^2.0.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/hapi__joi": "^17.1.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minimist": "^1.2.5",
    "@types/mongoose-aggregate-paginate-v2": "^1.0.12",
    "@types/ms": "^0.7.34",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.57.1",
    "globals": "^16.0.0",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
