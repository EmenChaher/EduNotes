<body
  style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <div
      style="background-color: rgb(16, 125, 172); color: #fff; padding: 20px; text-align: center; border-radius: 8px 8px 0px 0px;">
      <h1 style="margin: 0; text-align: center; font-size: 42px;">Réinitialisation du mot de passe</h1>
    </div>
    <div
      style="background-color: #f1f5f9; padding: 20px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); border-radius: 0px 0px 8px 8px;">
      <h2 style="font-size: 28px; font-weight: 600; margin-bottom: 20px; color: #000">Demande de réinitialisation de mot
        de passe</h2>
      <p style="color: #000">Cher <span style="font-weight: 600;color: #000"><%= name %></span>,</p>
      <p style="color: #000">Vous avez reçu cet email car une demande de réinitialisation du mot de passe a été
        effectuée pour votre compte.</p>
      <p style="color: #000">Si vous n'avez pas demandé cette réinitialisation, veuillez ignorer cet email ou nous
        contacter.</p>
      <p style="color: #000">Cliquez sur le bouton ci-dessous pour réinitialiser votre mot de passe :</p>
      <a href="<%= link %>"
        style="font-weight: 600; display: inline-block; text-align: center; background-color: rgb(16, 125, 172); color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 5px; margin-top: 20px;">Réinitialiser
        le mot de passe</a>
    </div>
  </div>

</body>